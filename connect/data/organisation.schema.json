{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "digizone-connect-organisation-0.2",
  "title": "DigiZone Connect fictional organisation record v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "category",
    "location",
    "summary",
    "hours",
    "offerings",
    "contact",
    "fictional",
    "publication",
    "profilePath"
  ],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 2, "maxLength": 80 },
    "name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "category": { "enum": ["ECD Centre", "Bakery", "Plumbing"] },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "city", "province"],
      "properties": {
        "area": { "type": "string", "minLength": 2, "maxLength": 80 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "province": { "type": "string", "minLength": 2, "maxLength": 80 }
      }
    },
    "summary": { "type": "string", "minLength": 12, "maxLength": 280 },
    "hours": { "type": "string", "minLength": 2, "maxLength": 80 },
    "offerings": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "minLength": 2, "maxLength": 80 }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": { "label": { "const": "Demo enquiry only" } }
    },
    "fictional": { "const": true },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": { "enum": ["static-demo", "not-published"] },
        "note": { "type": "string", "minLength": 12, "maxLength": 240 }
      }
    },
    "profilePath": { "type": "string", "maxLength": 120 }
  }
}
